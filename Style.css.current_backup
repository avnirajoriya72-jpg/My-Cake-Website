/* Breadcrumb */
.breadcrumb-container {
    padding: 18px 5% 8px 5%;
    font-size: 0.9rem;
    color: #7b7168;
}

.breadcrumb-container a {
    color: #7b7168;
    text-decoration: none;
}

.breadcrumb-container a:hover {
    color: var(--theme-brown);
}

.breadcrumb-container .sep {
    margin: 0 8px;
    color: #baa99b;
}

.breadcrumb-container .active-page {
    color: var(--theme-brown);
    font-weight: 600;
}

/* Hero Banner */
.wedding-hero-section {
    padding: 10px 5% 30px 5%;
}

.wedding-hero-banner {
    background: linear-gradient(135deg, #f7efe6 0%, #faeee3 50%, #f4e7d7 100%);
    border: 1px solid var(--theme-border-cream);
    border-radius: 28px;
    padding: 45px 50px;
    position: relative;
    overflow: hidden;
}

.banner-doodle {
    position: absolute;
    pointer-events: none;
    opacity: 0.5;
}

.doodle-flower {
    top: 15px;
    left: 38%;
}

.doodle-cookie {
    top: 18px;
    left: 52%;
}

/* Hero Arch Cake */
.hero-arch-wrapper {
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
    border-radius: 46% 46% 40% 40% / 50% 50% 44% 44%;
    overflow: hidden;
    border: 6px solid #ffffff;
    box-shadow: 0 15px 35px rgba(104, 46, 20, 0.16);
}

.hero-arch-img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    display: block;
}

.hero-main-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 700;
    line-height: 1.22;
    color: #231b17;
    margin-bottom: 1.1rem;
}

.hero-main-title .brown-accent {
    color: var(--theme-brown);
    font-style: italic;
    font-family: var(--font-serif);
}

.hero-desc-text {
    color: #554a43;
    font-size: clamp(0.95rem, 1.35vw, 1.1rem);
    line-height: 1.6;
    max-width: 580px;
    margin-bottom: 2rem;
}

.btn-contact-orders {
    display: inline-block;
    background-color: var(--theme-brown);
    color: #ffffff;
    text-decoration: none;
    border-radius: 8px;
    padding: 13px 34px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(104, 46, 20, 0.25);
    transition: all 0.3s;
}

.btn-contact-orders:hover {
    background-color: var(--theme-brown-dark);
    color: #ffffff;
    transform: translateY(-2px);
}

/* Trust Badges */
.trust-features-section {
    padding: 5px 5% 35px 5%;
}

.trust-features-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.trust-badge-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 10px 15px;
}

.trust-icon-circle {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background-color: #f7ede3;
    color: var(--theme-brown);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
    border: 1px solid #ebd9c7;
}

.trust-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: #2b231f;
}

/* 3-Column Cake Gallery (Exact match to Screenshots) */
.wedding-gallery-section {
    padding: 10px 5% 70px 5%;
}

.wedding-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
}

.cake-gallery-card {
    position: relative;
    border-radius: 50px 18px 75px 18px;
    overflow: hidden;
    background-color: #ffffff;
    border: 8px solid var(--theme-border-cream);
    box-shadow: 0 6px 22px rgba(104, 46, 20, 0.06);
    transition: transform all 0.35s ease, box-shadow 0.35s ease;
}

.cake-gallery-card:hover {
    transform: translateY(-6px);
    border-color: #f3e3ce;
    box-shadow: 0 14px 32px rgba(104, 46, 20, 0.12);
}

.card-img-holder {
    position: relative;
    width: 100%;
    height: 380px;
    background-color: #f8f3ec;
    overflow: hidden;
    border-radius: 42px 10px 67px 10px;
}

.card-img-holder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
    border-radius: 42px 10px 67px 10px;
}

.cake-gallery-card:hover .card-img-holder img {
    transform: scale(1.05);
}

/* "Customize Now" WhatsApp Pill Button */
.btn-customize-pill {
    position: absolute;
    bottom: 16px;
    left: 50%;
    right: 18px;
    background-color: #ffffff;
    color: #332b27;
    border: 1.5px solid #e2d2c1;
    border-radius: 30px;
    padding: 7px 22px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    transition: all 0.25s ease;
    z-index: 5;
    white-space: nowrap;
}

.btn-customize-pill:hover {
    background-color: var(--theme-brown);
    color: #ffffff;
    border-color: var(--theme-brown);
    ransform: translateX(-50%) translateY(-2px);
}

.btn-customize-pill:hover i {
    color: #ffffff !important;
}

/* Floating WhatsApp Button (Bottom Left) */
.floating-whatsapp-btn {
    position: fixed;
    bottom: 25px;
    left: 25px;
    width: 55px;
    height: 55px;
    background-color: #25d366;
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.9rem;
    text-decoration: none;
    z-index: 9999;
    box-shadow: 0 5px 18px rgba(37, 211, 102, 0.45);
    transition: transform 0.3s ease;
}

.floating-whatsapp-btn:hover {
    transform: scale(1.12);
    color: #ffffff;
}

/* Back to Top Button (Bottom Right) */
.back-to-top-btn {
    position: fixed;
    bottom: 25px;
    right: 25px;
    width: 44px;
    height: 44px;
    background-color: #000000;
    color: #ffffff;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    cursor: pointer;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}

.back-to-top-btn.visible {
    opacity: 1;
    visibility: visible;
}

/* Mobile & Tablet Responsive */
@media (max-width: 1024px) {
    .wedding-gallery-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .card-img-holder {
        height: 330px;
    }
}

@media (max-width: 768px) {
    .trust-features-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .wedding-hero-banner {
        padding: 30px 20px;
    }

    .hero-arch-img {
        height: 280px;
    }

    .wedding-gallery-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .card-img-holder {
        height: 300px;
    }
}

