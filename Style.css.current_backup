/* Product Grid Layout */
.product-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* 3 Columns Desktop pe */
    gap: 24px;
    padding: 30px 5%;
    background-color: #fff;
}

/* Outer Card Container (First Photo Jaisa Look) */
.product-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    /* Outer Light Border */
    border-radius: 16px;
    /* Rounded Corners */
    padding: 8px;
    /* Inside Space */
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-card:hover {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

/* Image Container with Proper Aspect Ratio */
.product-image-wrapper {
    position: relative;
    width: 380px;
    height: 380px;
    /* Fixed Height-Width Ratio */
    border-radius: 15px;
    /* Rounded Image Corners */
    overflow: hidden;
    background-color: #f7f7f7;
}

.product-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Image stretch nahi hogi */
    display: block;
    transform: scale(1.08);
}

/* Wishlist Heart Icon Top-Right */
.card-wishlist-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
    z-index: 2;
}

.card-wishlist-btn svg {
    width: 16px;
    height: 16px;
    stroke: #444;
}

/* Product Info Section */
.product-card-info {
    padding-top: 14px;
    padding-left: 2px;
}

.product-card-title {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 6px;
    font-family: sans-serif;
}

.product-card-price {
    font-size: 15px;
    font-weight: 700;
    color: #000;
    margin: 0;
    font-family: sans-serif;
}

/* Responsive Grid for Mobile */
@media (max-width: 992px) {
    .product-container {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 576px) {
    .product-container {
        grid-template-columns: repeat(1, 1fr);
        gap: 16px;
    }
}

/* ========================================================
   WEDDING CAKES PAGE STYLES (MATCHING PHOTO 1 & 2)
   ======================================================== */

:root {
    --theme-brown: #682e14;
    --theme-brown-dark: #50210b;
    --theme-border-cream: #f4e8d8;
    --text-dark: #231b17;
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans: 'Poppins', sans-serif;
}

body {
    font-family: var(--font-sans);
    color: var(--text-dark);
    background-color: #ffffff;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
}

/* Header */
.header-main {
    background: #ffffff;
    padding: 12px 4%;
    border-bottom: 1px solid #f0e6dc;
}

.nav-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.logo-area .logo-img {
    max-height: 48px;
    width: auto;
}

.search-area {
    flex-grow: 1;
    max-width: 460px;
}

.search-bar {
    position: relative;
    width: 100%;
}

.search-bar input {
    width: 100%;
    padding: 8px 45px 8px 18px;
    border-radius: 30px;
    border: 1px solid #dfd2c4;
    background-color: #faf7f2;
    font-size: 0.9rem;
    outline: none;
}

.search-icon {
    position: absolute;
