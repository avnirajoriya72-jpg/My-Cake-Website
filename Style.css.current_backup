}


/* Insta SECTION */
.insta-section {
    padding: 60px 20px;
    background-image: url("Food_Boxes_Banner.png");
    min-height: 800px;
    background-size: cover;
    background-position: center;
    margin-top: 150px;
    padding-top: 40px;
}

/* TITLE */
.insta-title {
    font-size: 40px;
    font-weight: bold;
    margin: left -20px;

}

.insta-title span {
    color: black;

}

.insta-desc {
    margin: 10px 0 40px;
}

/* BUTTON */
.insta-btn {
    display: block;
    /* 🔥 inline-block hatao */
    margin: 30px auto;
    /* center */
    padding: 12px 20px;
    border: 1px solid black;
    border-radius: 30px;
    text-decoration: none;
    color: black;
    width: fit-content;
    /* content ke according */
    max-width: 90%;
    /* mobile me bahar nahi jayega */
    text-align: center;
}

@media (max-width: 768px) {
    .insta-btn {

        font-size: 14px;
    }
}

.insta-slider {
    display: flex;
    gap: 20px;
    margin-top: 50px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* ⭐ SNAP EFFECT */
    scroll-behavior: smooth;
    padding: 20px;
}

/* HIDE SCROLLBAR */
.insta-slider::-webkit-scrollbar {
    display: none;
}

/* CARD */
.insta-card {
    min-width: 220px;
    height: 300px;

    flex-shrink: 0;
    border-radius: 15px;
    overflow: hidden;

    scroll-snap-align: start;
    /* ⭐ SNAP POINT */
    position: relative;
}

/* IMAGE */
.insta-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* OVERLAY */
.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);

    display: flex;
    justify-content: center;
    align-items: center;

    opacity: 0;
    transition: 0.3s;
}

/* HOVER */
.insta-card:hover .overlay {
    opacity: 1;
}

/* ICON */
.overlay i {
    color: white;
    font-size: 30px;
}

/* MOBILE */
@media (max-width:768px) {
    .insta-title {
        font-size: 28px;
    }

    .insta-card {
        min-width: 180px;
    }

    .insta-card img {
        height: 250px;
    }
}

