    padding: 10px 5px 20px;
}

/* Combo card */
#comboMobileCarousel .card {
    width: 100%;
    max-width: 270px;
    margin: auto;
    overflow: hidden;
    border: none;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.10);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
}

/* Image area */
#comboMobileCarousel .img-box {
    position: relative;
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: #fffaf6;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Smaller combo image */
#comboMobileCarousel .img-box img {
    width: 100%;
    height: 100%;
    padding: 12px;
    object-fit: contain;
    transition: transform 0.5s ease;
}

/* Image hover animation */
#comboMobileCarousel .card:hover .img-box img {
    transform: scale(1.06);
}

/* Wishlist heart */
#comboMobileCarousel .heart-icon {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    color: #7a3618 !important;
    border: 1px solid #eeeeee;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    font-size: 21px;
    line-height: 1;
    cursor: pointer;
    transition: all 0.3s ease;
}

#comboMobileCarousel .heart-icon:hover {
    transform: scale(1.15);
}

#comboMobileCarousel .heart-icon.wishlisted {
    color: #e63946 !important;
}

/* Product details */
#comboMobileCarousel .cake-info {
    padding: 14px 12px 18px;
    text-align: center;
}

#comboMobileCarousel .cake-info .name {
    font-size: 16px;
    font-weight: 600;
    color: #3b2922;
    margin-bottom: 7px;
}

#comboMobileCarousel .cake-info .price {
    font-size: 14px;
    color: #8b4b35;
    font-weight: 500;
}

/* Slider arrows */
#comboMobileCarousel .carousel-control-prev,
#comboMobileCarousel .carousel-control-next {
    width: 30px;
    opacity: 1;
}

#comboMobileCarousel .carousel-control-prev-icon,
#comboMobileCarousel .carousel-control-next-icon {
    background-color: #7a3618;
    border-radius: 50%;
    padding: 12px;
    background-size: 55%;
}

/* Mobile spacing */
@media (max-width: 767px) {
    #comboMobileCarousel {
        max-width: 340px;
    }
}

/* =========================
   RAKHI PRODUCT SECTION
========================= */

.product-container {
    width: 90%;
    max-width: 1400px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    padding: 40px 0;
}

/* PRODUCT CARD */

.product-card {
    min-width: 0;
    border: 1px solid #d8d8d8;
    border-radius: 22px;
    overflow: hidden;
    position: relative;
    background: #fff;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
}

.product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
}

/* PRODUCT IMAGE */

.product-card img {
    display: block;
    width: 100%;
    height: 340px;
    object-fit: contain;
    padding: 14px;
    border-radius: 18px;
    cursor: pointer;
}

/* WISHLIST HEART */

.wishlist {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 5;
    width: 38px;
    height: 38px;
    border: 1px solid #fff;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #7a3618;
    background: #fff;
    font-size: 18px;
    cursor: pointer;
    backdrop-filter: blur(5px);
}

/* PRODUCT INFORMATION */

.product-info {
    padding: 0 18px 20px;
}

.product-info h3 {
    font-size: 25px;
    font-weight: 400;
    margin-bottom: 8px;
    color: #000;
    overflow-wrap: anywhere;
}

.product-info p {
    font-size: 27px;
    font-weight: bold;
    color: #000;
    margin-bottom: 0;
}

/* TABLET */

@media (min-width: 577px) and (max-width: 992px) {
    .product-container {
        width: 92%;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .product-card img {
        height: 290px;
    }

    .product-info h3 {
        font-size: 21px;
    }

    .product-info p {
        font-size: 23px;
    }
}

/* MOBILE SLIDER */

@media (max-width: 576px) {
    .product-container {
        display: flex;
        width: 100%;
        gap: 15px;
        padding: 20px 5% 30px;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }

    .product-container::-webkit-scrollbar {
        display: none;
    }

    .product-card {
        flex: 0 0 85%;
        max-width: 85%;
        border-radius: 15px;
        scroll-snap-align: center;
    }

    .product-card img {
        height: 260px;
        padding: 8px;
        border-radius: 15px;
    }

    .wishlist {
        top: 9px;
        right: 9px;
        width: 31px;
        height: 31px;
        font-size: 15px;
    }

    .product-info {
        padding: 0 10px 13px;
    }

    .product-info h3 {
        font-size: 19px;
        line-height: 1.4;
        margin-bottom: 5px;
    }

    .product-info p {
        font-size: 22px;
    }
}