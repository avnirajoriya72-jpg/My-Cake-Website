/* --- Grid & Slider Setup --- */
.slider-wrapper {
    width: 100%;
}

.cards-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* Desktop: 3 Cards */
    gap: 80px;
    padding: 20px 0;
}

/* --- Card Styling (No Zoom) --- */
.cards {
    background: #fff;
    padding: 30px 20px;
    border-radius: 20px;
    /* Halka border depth ke liye */
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;

}

/* Circle & Icon */
.icon-circle {
    width: 380px;
    height: 380px;
    border-radius: 90%;
    border: 2px solid gray;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    margin-bottom: 20px;
}

/* Brown Arc Line */
.icon-circle::before {
    content: '';
    position: absolute;

    /* Inset -3px matlab ye main circle se thoda bahar niklega */
    /* Agar abhi bhi nahi dikh raha, toh ise 0 karke dekhein */
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;

    border-radius: 50%;
    border: 4px solid var(--brown);

    /* Top aur Left border dikhegi, baaki transparent */
    border-color: var(--brown) transparent transparent var(--brown);

    transform: rotate(-45deg);
    z-index: 1;
    /* Taaki ye upar dikhe */
}

.cards img {
    width: 200px;
    height: auto;
}

.cards h3 {
    font-family: 'Abril Fatface', cursive;
    font-size: 30px;
    margin-bottom: 0;
    color: #7a3e18;
    font-weight: bold;
}

.cards p {
    font-size: 28px;
    color: var(--light-gray);
    line-height: 1.4;
    margin-top: 25px;
}

