    border-radius: 80px 21px 20px 20px;
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    box-shadow: 0px 4px 21px 0px rgba(0, 0, 0, 0.25);
}

.story-stamp {
    position: absolute;
    top: 10px;
    left: 200px;
    width: 90px;
    z-index: 3;
    background-color: white;
    border-radius: 50px;
    border: 1px solid black;
}

