}

.pay-visa {
    font-style: italic;
    color: #1a1f71;
    font-weight: 800;
}

.pay-mastercard {
    position: relative;
    width: 36px;
    height: 24px;
    background: #ffffff;
}

.pay-mastercard::before,
.pay-mastercard::after {
    content: '';
    position: absolute;
    top: 4px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
}

.pay-mastercard::before {
    left: 5px;
    background: #eb001b;
}

.pay-mastercard::after {
    right: 5px;
    background: #f79e1b;
    opacity: 0.85;
