/* Prevent unwanted horizontal scrolling */
@media (max-width: 992px) {

    /* Cake collection */
    .main-i {
        padding-left: 15px;
        padding-right: 15px;
    }

    .main-i h1 {
        max-width: 100%;
        font-size: clamp(22px, 4vw, 36px);
        padding: 12px 18px;
    }

    .main-i h2 {
        font-size: clamp(28px, 5vw, 48px);
    }

    .main-i p {
        font-size: clamp(16px, 2.5vw, 22px);
        padding: 0 10px;
    }

    .circle-img {
        width: min(75vw, 320px);
        height: auto;
        aspect-ratio: 1 / 1;
    }

    /* Our Story */
    .story-content-container {
        gap: 25px;
        padding: 50px 20px;
    }

    .story-left-panel,
    .story-middle-panel,
    .story-right-panel {
        min-width: 0;
    }

    .arch-cake-img {
        width: 100%;
        max-width: 320px;
    }

    .story-brown-arch {
        width: 100%;
        max-width: 300px;
    }

    .story-stamp {
        left: auto;
        right: 5%;
    }

    .mid-banner-right-icon-box {
        margin-left: 0;
        justify-content: center;
    }

    /* Instagram section */
    .insta-section {
        padding-left: 15px;
        padding-right: 15px;
        margin-top: 60px;
    }

    .insta-title {
        font-size: clamp(24px, 4vw, 36px);
    }

    .insta-desc {
        font-size: 16px;
    }
}

/* Tablet and mobile */
@media (max-width: 768px) {

    /* Cake collection */
    .box {
        flex-wrap: wrap;
        gap: 20px;
        align-items: center;
    }

    .circle-img {
        width: min(70vw, 280px);
        margin-top: 25px;
        padding: 12px;
    }

    /* Our Story: stack the three panels */
    .story-content-container {
        flex-direction: column;
        align-items: center;
        text-align: center;
        min-height: auto;
        padding: 40px 18px;
        gap: 25px;
    }

    .story-left-panel,
    .story-middle-panel,
    .story-right-panel {
        width: 100%;
        flex: 0 0 auto;
    }

    .story-middle-panel {
        min-height: 300px;
        margin: 10px 0;
    }

    .arch-cake-img {
        width: 100%;
        max-width: 240px;
        margin-top: 35px;
    }

    .story-brown-arch {
        width: 85%;
        max-width: 250px;
        height: 300px;
        top: 10px;
    }

    .story-stamp {
        width: 55px;
        right: 10%;
        top: 0;
    }

    .story-red-line-text p {
        font-size: 16px !important;
        line-height: 1.6;
    }

    .story-desc,
    .story-sub-desc {
        font-size: 16px;
        line-height: 1.6;
    }



    .mid-banner-right-icon-box {
        margin-top: 20px;
    }

    /* Instagram cards stay horizontally scrollable */
    .insta-slider {
        gap: 14px;
        padding: 12px 2px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
    }

    .insta-card {
        flex: 0 0 75%;
        min-width: 0;
        max-width: 280px;
        height: 250px;
        scroll-snap-align: start;
    }

    .insta-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}

/* Small mobile screens */
@media (max-width: 480px) {

    .main-i h1 {
        font-size: 21px;
        padding: 10px 14px;
    }

    .main-i h2 {
        font-size: 26px;
    }

    .main-i p {
        font-size: 15px;
        margin-top: 25px;
    }

    .story-content-container {
        padding: 30px 14px;
    }

    .story-badge {
        font-size: 15px;
        padding: 8px 18px;
    }

    .story-about-btn {
        padding: 10px 20px;
        font-size: 14px;
    }

    .insta-section {
        min-height: auto;
        padding-top: 30px;
        padding-bottom: 30px;
        margin-top: 35px;
    }

    .insta-title {
        font-size: 23px;
        line-height: 1.35;
    }

    .insta-desc {
        font-size: 14px;
        line-height: 1.6;
    }

    .insta-card {
        flex-basis: 82%;
        height: 230px;
    }
}



