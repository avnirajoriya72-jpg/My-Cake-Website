/* Core Section Style */
/* Default (Desktop) */
.story-content-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    background-image: url("Food_Boxes_Banner.png");
    background-size: cover;
    /*  image ko full section me fit karega */
    background-position: center;
    /*  image center me rahegi */
    background-repeat: no-repeat;
    /*  repeat nahi hogi */
    margin-bottom: 30px;
    width: 100%;
    min-height: 700px;
    /*  section full screen height lega */

    padding: 80px 20px;

}

.story-badge {
    border: 1px solid black;
    background-color: #FCE0AE;
    border-radius: 50px;
    padding: 10px 30px;
    font-size: 20px;
    color: black;

}


/* Panels */
.story-left-panel,
.story-middle-panel,
.story-right-panel {
    flex: 1;
}

/* Middle image styling */
.story-middle-panel {
    position: relative;
    text-align: center;
}

.arch-cake-img {
    width: 150%;
