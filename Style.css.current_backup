    padding: 16px 60px;
    display: flex;
    align-items: center;
    border-bottom: 2px solid #f0e0d0;
}

.co-step {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: #bbb;
    font-weight: 500;
}

.co-step.co-active {
    color: #7a3b12;
    font-weight: 700;
}

.co-step.co-done {
    color: #2e7d32;
}

.co-step-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #eee;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
}

.co-step.co-active .co-step-num {
    background: #7a3b12;
    color: #fff;
}

.co-step.co-done .co-step-num {
    background: #2e7d32;
    color: #fff;
}

.co-step-line {
    flex: 1;
    height: 2px;
    background: #e0d0c0;
    margin: 0 16px;
    max-width: 80px;
}

.co-wrapper {
    max-width: 1400px;
    margin: 36px auto;
    padding: 0 50px;
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 36px;
    align-items: start;
}

.co-left {
    display: flex;
    flex-direction: column;
    gap: 28px;
}

.co-card {
    background: #fff;
    border-radius: 20px;
    padding: 36px 40px;
    box-shadow: 0 4px 20px rgba(122, 59, 18, 0.07);
}

.co-card-title {
    font-size: 19px;
    font-weight: 700;
    color: #7a3b12;
    margin-bottom: 26px;
    padding-bottom: 14px;
    border-bottom: 2px solid #f5e8dc;
    display: flex;
    align-items: center;
    gap: 10px;
}

.co-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.co-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.co-field.co-full {
    grid-column: 1 / -1;
}

.co-field label {
    font-size: 13px;
    font-weight: 600;
    color: #666;
}

.co-field input,
.co-field select,
.co-field textarea {
    padding: 13px 16px;
    border: 1.5px solid #e0d0c0;
    border-radius: 12px;
    font-size: 15px;
    outline: none;
    background: #fdfaf7;
    transition: border 0.2s, box-shadow 0.2s;
}

.co-field input:focus,
.co-field select:focus,
.co-field textarea:focus {
    border-color: #7a3b12;
    box-shadow: 0 0 0 3px rgba(122, 59, 18, 0.08);
    background: #fff;
}

.co-field textarea {
    resize: none;
    height: 90px;
}

/* Payment options */
.co-pay-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.co-pay-opt {
    border: 2px solid #e8ddd5;
    border-radius: 14px;
    padding: 18px 20px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fdfaf7;
}

.co-pay-opt:hover {
    border-color: #7a3b12;
    background: #fdf0e6;
}

.co-pay-opt.co-selected {
    border-color: #7a3b12;
    background: #fdf0e6;
    box-shadow: 0 0 0 3px rgba(122, 59, 18, 0.1);
}

.co-pay-opt input[type="radio"] {
    accent-color: #7a3b12;
    width: 17px;
    height: 17px;
    flex-shrink: 0;
}

.co-pay-icon {
    font-size: 26px;
}

.co-pay-opt strong {
    font-size: 15px;
    display: block;
    color: #222;
}

.co-pay-opt span {
    font-size: 12px;
    color: #999;
}

.co-pay-extra {
    display: none;
    grid-column: 1 / -1;
    background: #fdf5ee;
    border: 1.5px solid #f0d8c0;
    border-radius: 14px;
    padding: 20px 24px;
}

.co-pay-extra.co-show {
    display: block;
}

/* Summary */
.co-right {
    position: sticky;
    top: 20px;
}

.co-summary {
    background: #fff;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(122, 59, 18, 0.07);
}

.s-item {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #f5ede5;
}

.s-item:last-child {
    border-bottom: none;
}

.s-item img {
    width: 65px;
    height: 65px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
}

.s-item-name {
    font-size: 14px;
    font-weight: 600;
    color: #222;
    margin-bottom: 3px;
}

.s-item-qty {
    font-size: 12px;
    color: #999;
}

.s-item-price {
    font-size: 14px;
    font-weight: 700;
    color: #7a3b12;
}

.co-divider {
    border: none;
    border-top: 1.5px solid #f0e4d8;
    margin: 16px 0;
}

.co-coupon {
    display: flex;
    gap: 10px;
    margin-bottom: 6px;
}

.co-coupon input {
    flex: 1;
    padding: 11px 14px;
    border: 1.5px solid #e0d0c0;
    border-radius: 10px;
    font-size: 14px;
    outline: none;
    background: #fdfaf7;
}

.co-coupon input:focus {
    border-color: #7a3b12;
}

.co-coupon button {
    padding: 11px 20px;
    background: #7a3b12;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
}

.co-coupon button:hover {
    background: #5a2a0a;
}

.co-row {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    color: #555;
    margin-bottom: 10px;
}

.co-free {
    color: #2e7d32;
    font-weight: 700;
}

.co-discount {
    color: #2e7d32;
}

.co-total {
    font-size: 20px;
    font-weight: 800;
    color: #222;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 2px solid #f0e4d8;
}

.co-total span:last-child {
    color: #7a3b12;
}

.co-order-btn {
    width: 100%;
    padding: 16px;
    background: linear-gradient(135deg, #7a3b12, #a0521a);
    color: #fff;
    border: none;
    border-radius: 14px;
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 18px;
    box-shadow: 0 4px 15px rgba(122, 59, 18, 0.3);
}

.co-order-btn:hover {
    background: linear-gradient(135deg, #5a2a0a, #7a3b12);
    transform: translateY(-1px);
}

.co-order-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
}

.co-secure {
    text-align: center;
    font-size: 12px;
    color: #aaa;
    margin-top: 12px;
}

.co-pay-icons {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 12px;
    font-size: 26px;
    opacity: 0.4;
}

/* Success */
#success-page {
    display: none;
    position: fixed;
    inset: 0;
    background: #fff;
    z-index: 9999;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
}

#success-page.show {
    display: flex;
}

.success-icon {
    font-size: 90px;
    margin-bottom: 20px;
}

.success-title {
    font-size: 36px;
    font-weight: 800;
    color: #2e7d32;
    margin-bottom: 10px;
}

.success-sub {
    font-size: 17px;
    color: #555;
    margin-bottom: 8px;
}

.success-order-id {
    font-size: 14px;
    color: #888;
    margin-bottom: 30px;
    background: #f5f5f5;
    padding: 10px 24px;
    border-radius: 30px;
    display: inline-block;
}

.success-btn {
    padding: 15px 50px;
    background: #7a3b12;
    color: #fff;
    border: none;
    border-radius: 30px;
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
}

@media (max-width: 1024px) {
    .co-wrapper {
        grid-template-columns: 1fr;
        padding: 0 20px;
    }

    .co-right {
        position: static;
    }

    .co-pay-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .co-grid {
        grid-template-columns: 1fr;
    }

    .co-card {
        padding: 22px 18px;
    }

    .co-steps {
        padding: 14px 20px;
    }
}

/* ==================== WISHLIST PAGE ==================== */
.wl-page-header {
    background: linear-gradient(135deg, #7a3b12, #a0521a);
    padding: 40px 60px;
    color: #fff;
}

.wl-page-header-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
}

.wl-title {
    font-size: 36px;
    font-weight: 800;
    margin: 0;
}

.wl-subtitle {
    font-size: 16px;
    opacity: 0.85;
    margin: 6px 0 0;
}

.wl-header-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.wl-add-all-btn {
    padding: 12px 24px;
    background: #fff;
    color: #7a3b12;
    border: none;
    border-radius: 30px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.wl-add-all-btn:hover {
    background: #fdf0e6;
    transform: translateY(-1px);
}

.wl-clear-btn {
    padding: 12px 24px;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 30px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.wl-clear-btn:hover {
    background: rgba(255, 255, 255, 0.25);
}

.wl-container {
    max-width: 1400px;
    margin: 40px auto;
    padding: 0 50px;
}

.wl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 28px;
}

/* WISHLIST CARD */
.wl-card {
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(122, 59, 18, 0.08);
    transition: transform 0.25s, box-shadow 0.25s;
    position: relative;
}

.wl-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 35px rgba(122, 59, 18, 0.15);
}

.wl-card-img-wrap {
    position: relative;
    height: 260px;
    overflow: hidden;
    cursor: pointer;
    background: #f5e6d3;
}

.wl-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.wl-card:hover .wl-card-img {
    transform: scale(1.06);
}

.wl-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
}

.wl-card:hover .wl-card-overlay {
    opacity: 1;
}

.wl-card-overlay span {
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    background: rgba(0, 0, 0, 0.4);
    padding: 10px 20px;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.4);
}

.wl-remove-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #fff;
    border: none;
    color: #e63946;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    z-index: 5;
    transition: all 0.2s;
}

.wl-remove-btn:hover {
    background: #e63946;
    color: #fff;
}

.wl-card-info {
    padding: 18px 20px 20px;
}

.wl-card-name {
    font-size: 15px;
    font-weight: 700;
    color: #222;
    margin-bottom: 6px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.wl-card-price {
    font-size: 18px;
    font-weight: 800;
    color: #7a3b12;
    margin-bottom: 10px;
}

.wl-card-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.wl-card-tags span {
    font-size: 11px;
    background: #fdf0e6;
    color: #7a3b12;
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid #f0d0b0;
    font-weight: 500;
}

.wl-cart-btn {
    width: 100%;
    padding: 12px;
    background: #7a3b12;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
}

.wl-cart-btn:hover {
    background: #5a2a0a;
}

/* EMPTY STATE */
.wl-empty {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 20px;
}

.wl-empty-icon {
    font-size: 80px;
    margin-bottom: 20px;
}

.wl-empty h2 {
    font-size: 28px;
    font-weight: 700;
    color: #333;
    margin-bottom: 10px;
}

.wl-empty p {
    font-size: 16px;
    color: #888;
    margin-bottom: 30px;
}

.wl-shop-btn {
    padding: 14px 40px;
    background: #7a3b12;
    color: #fff;
    border-radius: 30px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    transition: background 0.2s;
    display: inline-block;
}

.wl-shop-btn:hover {
    background: #5a2a0a;
    color: #fff;
}

@media (max-width: 768px) {
    .wl-page-header {
        padding: 28px 20px;
    }

    .wl-title {
        font-size: 26px;
    }

    .wl-container {
        padding: 0 16px;
        margin: 24px auto;
    }

    .wl-grid {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 16px;
    }

    .wl-card-img-wrap {
        height: 180px;
    }
}

/*dropdown css*/
/* Dropdown Open on Hover */

.nav-item.dropdown:hover .dropdown-menu {
    display: block;
    margin-top: 0;
}

/* Dropdown Box */

.dropdown-menu {
    background-color: white;

    width: 370px;
    /* Rectangle width */

    padding: 25px 0;

    border-radius: 2px;

    border: none;

    box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.15);

    margin-top: 0;
}

/* Dropdown Text */

.dropdown-item {
    color: brown !important;

    font-size: 25px;

    font-weight: 600;

    padding: 15px 25px;

    transition: 0.3s;
}

/* Hover Effect */

.dropdown-item:hover {
    background-color: #f8e7d4;
    color: darkred !important;
    padding-left: 28px;
}



/* =========================
   MOBILE RESPONSIVE
========================= */

@media(max-width:768px) {

    .dropdown-menu {

        width: 100%;

        min-width: 100%;

        border-radius: 6px;

        margin-top: 10px;

    }

    .dropdown-item {

        font-size: 18px;

        padding: 14px 20px;

    }

}

